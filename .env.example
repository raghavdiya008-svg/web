# App
NEXT_PUBLIC_APP_URL=https://editx-vault.vercel.app
NEXT_PUBLIC_APP_NAME="EditX Vault"
NODE_ENV=production

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://editx-vault.vercel.app

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_SERVER_ID=1538957031455596544
DISCORD_INVITE_URL=https://discord.gg/editx
DISCORD_BOT_TOKEN=your-bot-token-for-dm-webhook

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=EditX Vault 
EMAIL_REPLY_TO=support@editx.gg

# Encryption (for Discord tokens)
ENCRYPTION_KEY=32-byte-base64-encoded-key

# Analytics (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=